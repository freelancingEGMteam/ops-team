    "db:migrate:prod": "wrangler d1 migrations apply ops-db",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250428.0",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.13.2"
  }
}
