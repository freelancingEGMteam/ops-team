---
import "@/styles/global.css";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  image?: string | null;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Eternal Grace Hub",
  description = "Cinematic Bible stories, worship music, and practical resources for homes and churches.",
  canonicalPath = Astro.url.pathname,
  noindex = false,
  image = null,
  structuredData,
} = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const canonical = new URL(canonicalPath, siteUrl).toString();
const fullTitle =
  title === "Eternal Grace Hub" ? title : `${title} | Eternal Grace Hub`;
const socialImage = image ? new URL(image, siteUrl).toString() : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0a1422" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex,nofollow" : "index,follow"}
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eternal Grace Hub" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{fullTitle}</title>
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("egh-theme");
        document.documentElement.dataset.theme =
          saved === "light" ? "light" : "dark";
        const hash = window.location.hash;
        if (hash.startsWith("#/")) {
          history.replaceState(null, "", hash.slice(1));
        }
      })();
    </script>
  </head>
  <body>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
