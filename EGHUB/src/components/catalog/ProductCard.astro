---
import {
  formatPriceRange,
  landscapeArtworkUrl,
  type CatalogProduct,
} from "@/lib/catalog";
import { toPlainText, truncateText } from "@/lib/rich-text";
interface Props {
  product: CatalogProduct;
}
const { product } = Astro.props;
const eyebrow = product.collection_labels.length
  ? product.collection_labels.slice(0, 2).join(" · ")
  : product.tag || "Digital resource";
const blurb = truncateText(
  toPlainText(product.description) ||
    "A digital resource from Eternal Grace Hub.",
  150,
);
const artworkUrl = landscapeArtworkUrl(product.cover_url);
---

<article class="catalog-card item-shadow">
  <a href={`/resources/${product.slug}`}>
    <div class="catalog-art product-art">
      {
        artworkUrl ? (
          <img
            class="catalog-art-image"
            src={artworkUrl}
            alt={product.cover_alt || `${product.title} artwork`}
            loading="lazy"
            onerror="this.hidden = true; const fallback = this.closest('.catalog-art')?.querySelector('.catalog-art-fallback'); if (fallback) fallback.hidden = false"
          />
        ) : (
          <span aria-hidden="true">↓</span>
        )
      }
      {artworkUrl && (
        <span class="catalog-art-fallback" hidden>
          {product.title}
        </span>
      )}
    </div>
    <div class="catalog-card-copy">
      <span class="eyebrow">{eyebrow}</span>
      <h3>{product.title}</h3>
      <p>{blurb}</p>
      <div class="product-card-meta">
        <strong class="price">
          {
            formatPriceRange(
              product.starting_price_cents,
              product.max_price_cents,
            )
          }
        </strong>
        {
          product.download_count > 0 ? null : (
            <span class="product-availability">Files coming soon</span>
          )
        }
      </div>
    </div>
  </a>
</article>
