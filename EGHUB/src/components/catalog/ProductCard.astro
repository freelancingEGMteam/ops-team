---
import { formatMoney, type CatalogProduct } from "@/lib/catalog";
interface Props {
  product: CatalogProduct;
}
const { product } = Astro.props;
---

<article class="catalog-card item-shadow">
  <a class="catalog-card-link" href={`/resources/${product.slug}`}>
    <div class="catalog-art product-art">
      {
        product.cover_url ? (
          <img
            src={product.cover_url}
            alt={product.cover_alt || `${product.title} artwork`}
            loading="lazy"
          />
        ) : (
          <span>↓</span>
        )
      }
    </div>
    <div class="catalog-card-copy">
      <span class="eyebrow">
        {
          product.collection_labels.length
            ? product.collection_labels.slice(0, 2).join(" · ")
            : product.tag || product.kind.replaceAll("_", " ")
        }
      </span>
      <h3>{product.title}</h3>
      <p>
        {product.description || "A digital resource from Eternal Grace Hub."}
      </p>
      <div class="product-card-meta">
        <strong class="price">{formatMoney(product.price_cents)}</strong>
        {
          product.download_count > 0 ? null : (
            <span class="product-availability">Files coming soon</span>
          )
        }
      </div>
    </div>
  </a>
  <div class="product-card-actions">
    <a class="btn btn-ghost" href={`/resources/${product.slug}`}>View album</a>
    {
      product.price_cents > 0 && (
        <button
          class="btn btn-solid catalog-add-to-cart"
          type="button"
          data-product-id={product.id}
          data-product-slug={product.slug}
          data-product-title={product.title}
          data-product-price={product.price_cents}
        >
          Add to cart
        </button>
      )
    }
  </div>
</article>

<script>
  import { addProduct } from "@/lib/cart";

  document
    .querySelectorAll<HTMLButtonElement>(".catalog-add-to-cart")
    .forEach((button) => {
      button.addEventListener("click", () => {
        addProduct({
          id: button.dataset.productId || "",
          slug: button.dataset.productSlug || "",
          title: button.dataset.productTitle || "",
          price_cents: Number(button.dataset.productPrice || 0),
        } as Parameters<typeof addProduct>[0]);
        button.textContent = "Added to cart";
        window.setTimeout(() => {
          button.textContent = "Add to cart";
        }, 1600);
      });
    });
</script>

<style>
  .catalog-card-link {
    display: block;
  }
  .product-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0 20px 20px;
  }
  .product-card-actions .btn {
    flex: 1 1 130px;
    justify-content: center;
    min-height: 42px;
    font-size: 0.78rem;
  }
</style>
