---
import AuthNav from "@/components/auth/AuthNav";
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="container-wide nav-shell">
    <a href="/" class="brand" aria-label="Eternal Grace Hub home">
      <span class="brand-mark" aria-hidden="true">EG</span>
      <span>
        <strong>Eternal Grace Hub</strong>
        <small>Scripture · Worship · Grace</small>
      </span>
    </a>
    <form class="header-search" role="search" method="get" action="/search">
      <label class="sr-only" for="header-search">Search the catalog</label>
      <input
        id="header-search"
        type="search"
        name="q"
        placeholder="Search albums, chord sheets, videos…"
        autocomplete="off"
      />
      <button type="submit" aria-label="Search">
        <span aria-hidden="true">⌕</span>
      </button>
    </form>
    <button
      class="nav-mobile-btn"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="sr-only">Open menu</span><span aria-hidden="true">☰</span>
    </button>
    <nav id="primary-nav" class="nav-desktop" aria-label="Primary navigation">
      <a href="/">Home</a>
      <a href="/bibleinvideo">BibleInVideo</a>
      <a href="/resources">Worship</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/cart" class="cart-link"
        >Cart<span class="cart-count" hidden>0</span></a
      >
      <AuthNav client:load />
      <button class="theme-toggle" type="button" aria-label="Switch color theme"
        >◐</button
      >
    </nav>
  </div>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>(".nav-mobile-btn");
  const nav = document.querySelector<HTMLElement>("#primary-nav");
  const menuIcon = menuButton?.querySelector<HTMLElement>(
    "[aria-hidden='true']",
  );
  const setMenuOpen = (open: boolean) => {
    menuButton?.setAttribute("aria-expanded", String(open));
    if (menuIcon) menuIcon.textContent = open ? "×" : "☰";
    nav?.classList.toggle("is-open", open);
    document.body.classList.toggle("menu-open", open);
  };
  menuButton?.addEventListener("click", () => {
    const open = menuButton.getAttribute("aria-expanded") === "true";
    setMenuOpen(!open);
  });
  nav
    ?.querySelectorAll("a")
    .forEach((link) =>
      link.addEventListener("click", () => setMenuOpen(false)),
    );
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });
  document
    .querySelector<HTMLButtonElement>(".theme-toggle")
    ?.addEventListener("click", () => {
      const next =
        document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("egh-theme", next);
    });

  import("@/lib/cart").then(({ readCart }) => {
    const badge = document.querySelector<HTMLElement>(".cart-count");
    const refresh = () => {
      if (!badge) return;
      const count = readCart().length;
      badge.textContent = String(count);
      badge.hidden = count === 0;
    };
    refresh();
    window.addEventListener("egh-cart-changed", refresh);
    window.addEventListener("storage", (event) => {
      if (event.key === null || event.key === "egh-cart-v3") refresh();
    });
  });
</script>
<style>
  .cart-link {
    position: relative;
  }
  .cart-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    margin-left: 5px;
    border-radius: 99px;
    background: var(--gold);
    color: var(--on-gold);
    font-size: 10px;
    font-weight: 700;
    vertical-align: middle;
  }

  /* Always-visible catalog search, so finding a product never requires
     navigating to the search page first. */
  .header-search {
    display: flex;
    flex: 1 1 260px;
    max-width: 420px;
    margin: 0 20px;
  }
  .header-search input {
    flex: 1;
    min-width: 0;
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-right: 0;
    border-radius: 8px 0 0 8px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 0.9rem;
  }
  .header-search input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }
  .header-search input:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: -2px;
  }
  .header-search button {
    min-width: 44px;
    border: 1px solid var(--gold);
    border-radius: 0 8px 8px 0;
    background: var(--gold);
    color: var(--on-gold);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .header-search button:hover {
    background: var(--gold-bright);
    border-color: var(--gold-bright);
  }

  @media (max-width: 900px) {
    .header-search {
      order: 3;
      flex-basis: 100%;
      max-width: none;
      margin: 10px 0 0;
    }
  }
</style>
