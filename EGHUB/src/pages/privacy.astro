---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy Policy"
  description="How Eternal Grace Hub handles account, purchase, and contact information."
>
  <section class="content-page">
    <div class="container-narrow">
      <span class="eyebrow">Legal</span><h1>Privacy Policy</h1><div
        class="prose"
      >
        <p>
          We collect the account, purchase, billing, and contact information
          needed to provide the service. Payment card details are handled by
          Stripe and are not stored by Eternal Grace Hub.
        </p><h2>How information is used</h2><p>
          We use account information to authenticate customers, deliver
          purchases, provide support, prevent abuse, and meet legal and
          accounting obligations.
        </p><h2>Service providers</h2><p>
          Supabase provides authentication, database, and file storage; Stripe
          processes payments and taxes; Resend delivers transactional email;
          Vercel delivers the website.
        </p><h2>Your choices</h2><p>
          You may request access, correction, or deletion of eligible personal
          information through the contact page. Some order information may be
          retained where required for tax, fraud prevention, or accounting.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
