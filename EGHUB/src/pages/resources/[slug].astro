---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductPurchase from "@/components/commerce/ProductPurchase";
import ProductCard from "@/components/catalog/ProductCard.astro";
import {
  formatPriceRange,
  getMergedProductSlug,
  getProduct,
  getRelatedProducts,
  variantKindLabel,
} from "@/lib/catalog";
import { parseRichText, toPlainText, truncateText } from "@/lib/rich-text";
const { slug } = Astro.params;
const product = slug ? await getProduct(slug) : null;
if (!product) {
  const mergedSlug = slug ? await getMergedProductSlug(slug) : null;
  if (mergedSlug) return Astro.redirect(`/resources/${mergedSlug}`, 301);
  return Astro.redirect("/404");
}
const related = await getRelatedProducts(product);

const activeVariants = product.variants.filter((variant) => variant.is_active);
const eyebrow =
  product.collection_labels[0] ||
  product.tag ||
  activeVariants[0]?.kind.replaceAll("_", " ") ||
  "Digital resource";
const descriptionBlocks = parseRichText(product.description);
const plainDescription = toPlainText(product.description);
const metaDescription =
  truncateText(plainDescription, 160) ||
  `Download ${product.title} from Eternal Grace Hub.`;
const aboutBullets = [
  ...new Set(activeVariants.map((variant) => variantKindLabel(variant.kind))),
];
const inStock = product.download_count > 0;

const productStructuredData: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  description: plainDescription || null,
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: (product.starting_price_cents / 100).toFixed(2),
    highPrice: (product.max_price_cents / 100).toFixed(2),
    offerCount: activeVariants.length,
    availability: inStock
      ? "https://schema.org/InStock"
      : "https://schema.org/PreOrder",
  },
};
---

<BaseLayout
  title={product.title}
  description={metaDescription}
  canonicalPath={`/resources/${product.slug}`}
  image={product.cover_url}
  structuredData={productStructuredData}
>
  <section class="content-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/resources">Worship</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{product.title}</span>
      </nav>
    </div>
    <div class="container product-detail">
      <div class="product-gallery">
        <div class="product-detail-art">
          {
            product.cover_url ? (
              <>
                <img
                  class="catalog-art-backdrop"
                  src={product.cover_url}
                  alt=""
                  aria-hidden="true"
                />
                <img
                  class="catalog-art-image"
                  src={product.cover_url}
                  alt={product.cover_alt || `${product.title} artwork`}
                />
              </>
            ) : (
              <span aria-hidden="true">↓</span>
            )
          }
        </div>
      </div>

      <div class="product-info">
        <span class="eyebrow">{eyebrow}</span>
        <h1>{product.title}</h1>
        {
          aboutBullets.length > 0 && (
            <ul class="product-highlights">
              {aboutBullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )
        }
        {
          descriptionBlocks.length > 0 && (
            <div class="product-description">
              <h2>About this item</h2>
              {descriptionBlocks.map((block) =>
                block.type === "list" ? (
                  <ul>
                    {block.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                ) : (
                  <p>{block.text}</p>
                ),
              )}
            </div>
          )
        }
      </div>

      <aside class="buy-box panel">
        <span class="eyebrow">Price</span>
        <strong class="product-price">
          {
            formatPriceRange(
              product.starting_price_cents,
              product.max_price_cents,
            )
          }
        </strong>
        <p class={`buy-box-availability ${inStock ? "in-stock" : "pending"}`}>
          {inStock ? "✓ In stock — instant download" : "Files being prepared"}
        </p>
        <ProductPurchase client:load product={product} />
        <ul class="buy-box-assurances">
          <li>Instant digital download after purchase</li>
          <li>Secure checkout, tax calculated automatically</li>
          <li>Files available anytime from your account</li>
        </ul>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-shell section-contrast">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">More to explore</span>
              <h2>Related resources</h2>
            </div>
            <a href="/resources">All resources →</a>
          </div>
          <div class="catalog-grid">
            {related.map((item) => (
              <ProductCard product={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
<style>
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .breadcrumb a {
    color: var(--ink-soft);
  }
  .breadcrumb a:hover {
    color: var(--gold);
  }
  .breadcrumb [aria-current] {
    color: var(--ink-dim);
  }

  /* Gallery | details | buy box, so the title reads at the top of the page
     instead of sitting below a full-width cover image. */
  .product-detail {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr) 380px;
    gap: 36px;
    align-items: start;
    margin-top: 18px;
  }
  .product-gallery {
    position: sticky;
    top: 98px;
  }
  .product-detail-art {
    aspect-ratio: 16 / 9;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--line);
    border-radius: 10px;
    background:
      radial-gradient(
        circle at 65% 35%,
        rgba(85, 180, 168, 0.22),
        transparent 36%
      ),
      linear-gradient(145deg, #102a36, #07111f);
    color: var(--gold);
    font-size: 4rem;
  }
  .product-detail-art img {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: block;
  }
  .product-detail-art .catalog-art-backdrop {
    position: absolute;
    inset: -8%;
    width: 116%;
    height: 116%;
    object-fit: cover;
    filter: blur(24px) saturate(0.85) brightness(0.62);
    opacity: 0.78;
    transform: scale(1.08);
    z-index: -1;
  }
  .product-detail-art .catalog-art-image {
    position: relative;
    z-index: 0;
    object-fit: contain;
    padding: 12px 28px;
    filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.3));
  }

  .product-info h1 {
    margin-top: 6px;
  }
  .product-highlights {
    margin: 16px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 6px;
    color: var(--ink-dim);
  }
  .product-description {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--line-soft);
  }
  .product-description h2 {
    font-size: 1.1rem;
  }
  .product-description p {
    margin-top: 12px;
    color: var(--ink-dim);
  }
  .product-description ul {
    margin-top: 12px;
    padding-left: 20px;
    display: grid;
    gap: 6px;
    color: var(--ink-dim);
  }

  .buy-box {
    position: sticky;
    top: 98px;
    align-self: start;
    margin-top: 0;
    padding: 24px;
  }
  .product-price {
    display: block;
    margin-top: 6px;
    color: var(--gold-bright);
    font-size: 1.8rem;
  }
  .buy-box-availability {
    margin-top: 10px;
    font-size: 0.85rem;
  }
  .buy-box-availability.in-stock {
    color: var(--green);
  }
  .buy-box-availability.pending {
    color: var(--ink-soft);
  }
  .buy-box-assurances {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line-soft);
    list-style: none;
    display: grid;
    gap: 9px;
    color: var(--ink-dim);
    font-size: 0.85rem;
  }
  .buy-box-assurances li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 8px;
    align-items: start;
  }
  .buy-box-assurances li::before {
    content: "✓";
    color: var(--green);
    font-weight: 700;
  }

  @media (max-width: 1180px) {
    .product-detail {
      grid-template-columns: minmax(200px, 280px) minmax(0, 1fr);
    }
    .buy-box {
      grid-column: 1 / -1;
      position: static;
      max-width: 420px;
    }
  }
  @media (max-width: 720px) {
    .product-detail {
      grid-template-columns: 1fr;
    }
    .product-gallery {
      position: static;
      max-width: 360px;
    }
    .buy-box {
      max-width: none;
    }
  }
</style>
