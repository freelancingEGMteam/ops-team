---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AlbumCard from "@/components/catalog/AlbumCard.astro";
import EpisodeCard from "@/components/catalog/EpisodeCard.astro";
import EmptyState from "@/components/site/EmptyState.astro";
import { getCatalog } from "@/lib/catalog";
import familyImage from "../../uploads/pasted-1778596394226-0.png";

const catalog = await getCatalog();
const albums = catalog.albums.filter((album) => album.is_featured).slice(0, 6);
const episodes = catalog.episodes
  .filter((episode) => episode.is_featured)
  .slice(0, 6);
---

<BaseLayout
  title="Eternal Grace Hub"
  description="Faith-building films, worship music, and church resources rooted in Scripture."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Eternal Grace Hub",
    url: new URL(
      "/",
      import.meta.env.PUBLIC_SITE_URL || Astro.url.origin,
    ).toString(),
  }}
>
  <section class="home-hero-section">
    <div class="hero-split">
      <a class="hero-pane hero-pane-watch" href="/bibleinvideo">
        <div class="hero-pane-copy">
          <span class="eyebrow">Watch</span>
          <h1 class="hero-title">Faith-building films for every screen</h1>
          <p>
            Cinematic Bible stories for families, churches, and personal
            devotion.
          </p>
          <span class="btn btn-solid hero-cta">Watch episodes →</span>
        </div>
        <div class="hero-symbol" aria-hidden="true">▶</div>
      </a>
      <a class="hero-pane hero-pane-listen" href="/resources">
        <div class="hero-pane-copy">
          <span class="eyebrow">Listen</span>
          <h2 class="hero-title">Worship music for home and church</h2>
          <p>
            MP3s, lyric sheets, and chord books for worship leaders and
            families.
          </p>
          <span class="btn btn-solid hero-cta">Hear the albums →</span>
        </div>
        <div class="hero-symbol" aria-hidden="true">♫</div>
      </a>
    </div>
  </section>

  <section class="scripture-band">
    <div class="container">
      <span class="eyebrow">The heart of the work</span>
      <blockquote>
        “Let the word of Christ dwell in you richly… singing with grace in your
        hearts to the Lord.”
      </blockquote>
      <cite>Colossians 3:16</cite>
    </div>
  </section>

  <section class="new-family-section">
    <div class="container new-family-grid">
      <div class="new-family-copy">
        <span class="eyebrow">Start here</span>
        <h2>If you are new to the family</h2>
        <p>
          Eternal Grace Hub brings together cinematic Bible stories, worship
          albums, and practical resources for homes, churches, and small groups.
        </p>
        <div class="button-row">
          <a class="btn btn-solid" href="/about">Our story</a><a
            class="btn btn-ghost"
            href="/register">Create an account</a
          >
        </div>
      </div>
      <div class="new-family-image-wrap">
        <img
          src={familyImage.src}
          alt="A preview of Eternal Grace Hub media"
          width={familyImage.width}
          height={familyImage.height}
        />
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Latest releases</span><h2>
            From Eternal Grace Music
          </h2>
        </div><a href="/music/albums">All albums →</a>
      </div>
      {
        albums.length ? (
          <div class="catalog-grid">
            {albums.map((album) => (
              <AlbumCard album={album} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="The first record is being prepared."
            message="Published albums will appear here as soon as the Eternal Grace team releases them."
            actionHref="/register"
            actionLabel="Create an account"
          />
        )
      }
    </div>
  </section>

  <section class="section-shell section-contrast">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Cinematic storytelling</span><h2>
            From BibleInVideo
          </h2>
        </div><a href="/bibleinvideo">All stories →</a>
      </div>
      {
        episodes.length ? (
          <div class="catalog-grid">
            {episodes.map((episode) => (
              <EpisodeCard episode={episode} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="New Bible stories are on the way."
            message="Published episodes will appear here after the editorial team completes review."
            actionHref="/bibleinvideo"
            actionLabel="Visit BibleInVideo"
          />
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero-section {
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(201, 166, 97, 0.08),
        transparent 48%
      ),
      linear-gradient(180deg, var(--bg-deep), var(--bg));
  }
  .hero-split {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .hero-pane {
    min-height: 520px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: end;
    padding: clamp(28px, 5vw, 58px);
    border: 1px solid color-mix(in srgb, var(--gold) 28%, var(--line));
    border-radius: 10px;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .hero-pane:hover {
    transform: translateY(-3px);
    border-color: var(--gold);
  }
  .hero-pane-watch {
    background:
      radial-gradient(
        ellipse at 72% 24%,
        rgba(168, 72, 58, 0.3),
        transparent 58%
      ),
      linear-gradient(145deg, #12243a, #08111e);
  }
  .hero-pane-listen {
    background:
      radial-gradient(
        ellipse at 28% 70%,
        rgba(0, 138, 140, 0.25),
        transparent 58%
      ),
      linear-gradient(145deg, #081824, #050b16);
  }
  .hero-pane-copy {
    position: relative;
    z-index: 1;
    max-width: 510px;
  }
  .hero-title {
    margin-top: 14px;
    color: var(--ink);
    font-size: clamp(2.1rem, 4vw, 3.5rem);
    line-height: 1.06;
  }
  .hero-pane p {
    margin-top: 20px;
    color: #c8b995;
    font-size: 1rem;
    line-height: 1.65;
  }
  .hero-cta {
    margin-top: 28px;
  }
  .hero-symbol {
    position: absolute;
    right: 7%;
    top: 8%;
    font-size: 8rem;
    color: rgba(236, 223, 191, 0.07);
  }
  .scripture-band {
    padding: 42px 0;
    text-align: center;
    border-bottom: 1px solid var(--line);
    background: var(--bg-deep);
  }
  .scripture-band blockquote {
    max-width: 900px;
    margin: 14px auto 8px;
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.4;
  }
  .scripture-band cite {
    color: var(--gold);
    font-style: normal;
  }
  .new-family-section {
    padding: 72px 0;
  }
  .new-family-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    align-items: center;
  }
  .new-family-copy h2 {
    margin-top: 12px;
  }
  .new-family-copy p {
    margin-top: 22px;
    color: var(--ink-dim);
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .new-family-copy .button-row {
    margin-top: 28px;
  }
  .new-family-image-wrap {
    aspect-ratio: 16/10;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 30px 70px -46px #000;
  }
  .new-family-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .section-contrast {
    background: var(--bg-deep);
    border-block: 1px solid var(--line);
  }
  @media (max-width: 800px) {
    .hero-split,
    .new-family-grid {
      grid-template-columns: 1fr;
    }
    .hero-pane {
      min-height: 420px;
    }
    .hero-split {
      width: min(100% - 28px, 1180px);
    }
  }
</style>
