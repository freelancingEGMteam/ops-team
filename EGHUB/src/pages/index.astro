---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AlbumCard from "@/components/catalog/AlbumCard.astro";
import EpisodeCard from "@/components/catalog/EpisodeCard.astro";
import { getCatalog } from "@/lib/catalog";

const catalog = await getCatalog();

// Nothing in the catalog is flagged is_featured, so featuring is a
// preference rather than a requirement — fall back to the newest releases
// so the page is never advertising an empty shelf.
const featuredAlbums = catalog.albums.filter((album) => album.is_featured);
const albums = (featuredAlbums.length ? featuredAlbums : catalog.albums).slice(
  0,
  6,
);
const featuredEpisodes = catalog.episodes.filter(
  (episode) => episode.is_featured,
);
const episodes = (
  featuredEpisodes.length ? featuredEpisodes : catalog.episodes
).slice(0, 3);
const heroCovers = catalog.albums
  .filter((album) => album.cover_url)
  .slice(0, 4);
const albumCount = catalog.albums.length;
---

<BaseLayout
  title="Eternal Grace Hub"
  description="Faith-building films, worship music, and church resources rooted in Scripture."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Eternal Grace Hub",
    url: new URL(
      "/",
      import.meta.env.PUBLIC_SITE_URL || Astro.url.origin,
    ).toString(),
  }}
>
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <span class="home-eyebrow">Eternal Grace Music</span>
        <h1>Scripture you can sing.</h1>
        <p>
          {albumCount} worship albums drawn straight from the Psalms, the hymns, and
          the Gospels — with the MP3s, chord charts, and lyric sheets your church
          needs to lead them on Sunday.
        </p>
        <div class="home-hero-actions">
          <a class="home-btn home-btn-primary" href="/resources">
            Browse the music
          </a>
          <a class="home-btn home-btn-ghost" href="/music/albums">
            All {albumCount} releases
          </a>
        </div>
        <ul class="home-hero-points">
          <li>Instant download after purchase</li>
          <li>Chord charts and lyric sheets for worship leaders</li>
          <li>Yours forever in your account</li>
        </ul>
      </div>

      {
        heroCovers.length > 0 && (
          <div class="home-hero-art" aria-hidden="true">
            {heroCovers.map((album) => (
              <img src={album.cover_url} alt="" loading="eager" />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="scripture-band">
    <div class="container">
      <span class="eyebrow">The heart of the work</span>
      <blockquote>
        “Let the word of Christ dwell in you richly… singing with grace in your
        hearts to the Lord.”
      </blockquote>
      <cite>Colossians 3:16</cite>
    </div>
  </section>

  {
    albums.length > 0 && (
      <section class="section-shell">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">
                {featuredAlbums.length ? "Featured" : "Latest releases"}
              </span>
              <h2>From Eternal Grace Music</h2>
            </div>
            <a href="/music/albums">All albums →</a>
          </div>
          <div class="catalog-grid">
            {albums.map((album) => (
              <AlbumCard album={album} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="start-band">
    <div class="container">
      <span class="eyebrow">Start here</span>
      <h2>New to the Hub?</h2>
      <p>
        Create an account and every album, chord chart, and lyric sheet you buy
        stays in your library — downloadable any time, on any device.
      </p>
      <div class="button-row">
        <a class="btn btn-solid" href="/register">Create an account</a>
        <a class="btn btn-ghost" href="/about">Our story</a>
      </div>
    </div>
  </section>

  {
    episodes.length > 0 && (
      <section class="section-shell section-contrast">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">Cinematic storytelling</span>
              <h2>From BibleInVideo</h2>
            </div>
            <a href="/bibleinvideo">All stories →</a>
          </div>
          <div class="catalog-grid">
            {episodes.map((episode) => (
              <EpisodeCard episode={episode} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Deliberately explicit colours rather than theme tokens: styles.css
     forces .hero-pane backgrounds with !important in light mode, and a hero
     that inverts between themes loses all its contrast. This band reads the
     same in both, and matches the navy header. */
  .home-hero {
    background:
      radial-gradient(
        ellipse at 78% 18%,
        rgba(201, 166, 97, 0.22),
        transparent 55%
      ),
      linear-gradient(160deg, #0b1a2e 0%, #081422 60%, #060f1b 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: #fff;
    padding: clamp(48px, 7vw, 92px) 0;
  }
  .home-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .home-eyebrow {
    display: block;
    color: #c9a661;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .home-hero-copy h1 {
    margin-top: 14px;
    color: #fff;
    font-size: clamp(2.5rem, 5.2vw, 4.1rem);
    line-height: 1.03;
    letter-spacing: -0.01em;
  }
  .home-hero-copy > p {
    margin-top: 20px;
    max-width: 34em;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.65;
  }
  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .home-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 26px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }
  .home-btn:hover {
    transform: translateY(-1px);
  }
  .home-btn-primary {
    background: #c9a661;
    color: #1a1408;
    border: 1px solid #c9a661;
  }
  .home-btn-primary:hover {
    background: #e6c987;
    border-color: #e6c987;
  }
  .home-btn-ghost {
    border: 1px solid rgba(255, 255, 255, 0.34);
    color: #fff;
  }
  .home-btn-ghost:hover {
    border-color: #c9a661;
    color: #c9a661;
  }
  .home-hero-points {
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 9px;
  }
  .home-hero-points li {
    display: grid;
    grid-template-columns: 17px 1fr;
    gap: 9px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.9rem;
  }
  .home-hero-points li::before {
    content: "✓";
    color: #6fcf97;
    font-weight: 700;
  }

  .home-hero-art {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .home-hero-art img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 50px -22px rgba(0, 0, 0, 0.75);
  }
  /* Stagger the mosaic so it reads as artwork rather than a plain grid. */
  .home-hero-art img:nth-child(1) {
    transform: translateY(-14px);
  }
  .home-hero-art img:nth-child(4) {
    transform: translateY(14px);
  }

  .scripture-band {
    padding: 46px 0;
    text-align: center;
    border-bottom: 1px solid var(--line);
    background: var(--bg-deep);
  }
  .scripture-band blockquote {
    max-width: 900px;
    margin: 14px auto 8px;
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.4;
  }
  .scripture-band cite {
    color: var(--gold);
    font-style: normal;
  }

  .start-band {
    padding: 72px 0;
    text-align: center;
    border-block: 1px solid var(--line);
    background: var(--bg-deep);
  }
  .start-band h2 {
    margin-top: 12px;
  }
  .start-band p {
    max-width: 620px;
    margin: 18px auto 0;
    color: var(--ink-dim);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .start-band .button-row {
    justify-content: center;
    margin-top: 26px;
  }

  .section-contrast {
    background: var(--bg-deep);
    border-block: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .home-hero-grid {
      grid-template-columns: 1fr;
    }
    .home-hero-art {
      order: -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
    .home-hero-art img:nth-child(4) {
      display: none;
    }
    .home-hero-art img:nth-child(1),
    .home-hero-art img:nth-child(4) {
      transform: none;
    }
  }
</style>
