---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms"
  description="Terms for using Eternal Grace Hub and its digital resources."
>
  <section class="content-page">
    <div class="container-narrow">
      <span class="eyebrow">Legal</span><h1>Terms of Use</h1><div class="prose">
        <p>
          By using Eternal Grace Hub, you agree to provide accurate account
          information and to use purchased or free resources only under the
          license shown with each product.
        </p><h2>Accounts</h2><p>
          You are responsible for safeguarding your account and for activity
          performed through it. Staff may disable accounts used for fraud,
          abuse, or unauthorized distribution.
        </p><h2>Digital resources</h2><p>
          A purchase grants continuing access through the customer library. It
          does not transfer ownership of the underlying copyright or permit
          redistribution unless a product license explicitly says otherwise.
        </p><h2>Availability</h2><p>
          We work to keep the service available, but maintenance, provider
          outages, and security work may cause interruptions.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
